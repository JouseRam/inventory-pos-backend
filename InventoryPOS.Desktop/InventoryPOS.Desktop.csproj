<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WebView2's package also ships its WPF control, which needs the WPF reference set to resolve WindowsBase. -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MatizPOS</AssemblyName>
    <RootNamespace>InventoryPOS.Desktop</RootNamespace>
    <Product>Matiz POS</Product>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web app (ASP.NET Core) runs inside this process. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryPOS.API\InventoryPOS.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The front end is served from the API project's wwwroot, copied next to the executable. -->
    <Content Include="..\InventoryPOS.API\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Named apart from the API's appsettings.json, which is also copied here and would overwrite it. -->
    <Content Include="desktopsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
